# Environment Variables for APIDash Backend
# Copy this file to .env and configure for your local environment

NODE_ENV=development
PORT=5000

# Database Configuration (MySQL 8.0)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=api_monitor

# Legacy in-process scheduler (deprecated in Phase 4; disabled in server)
ENABLE_LEGACY_SCHEDULER=false

# Phase 4 Dedicated Background Worker Configuration
# Maximum concurrent HTTP monitor executions per worker process (default 5, 1-50)
WORKER_CONCURRENCY=5

# Polling interval in ms for due monitor checks (default 1000ms)
WORKER_POLL_INTERVAL_MS=1000

# Lease timeout in ms for crash recovery (default 60000ms; must be >= 35000ms)
WORKER_LEASE_MS=60000

# Recurring schedule interval in ms between monitor runs (default 30000ms)
SCHEDULER_INTERVAL_MS=30000

# Worker graceful shutdown timeout budget in ms (default 35000ms)
WORKER_SHUTDOWN_TIMEOUT_MS=35000

# Phase 5 SMTP & Email Notification Settings
# If SMTP is unconfigured or unavailable, incident detection and UI continue functioning normally
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=APIDash Alerts <alerts@apidash.local>

# Phase 5 Notification Outbox Dispatcher
OUTBOX_CONCURRENCY=5
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LEASE_MS=60000
OUTBOX_MAX_ATTEMPTS=5

# Phase 7 AI-Assisted Incident Investigation Settings
# Provider options: disabled (default), gemini, ollama
# System operates normally with AI disabled; AI features are strictly user-triggered
AI_PROVIDER=disabled

# Gemini API configuration (when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000

# Ollama local model server configuration (when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_MS=60000

# OpenRouter API configuration (when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_TIMEOUT_MS=60000
# OPENROUTER_MAX_TOKENS=4000

# Groq API configuration (when AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=30000
# GROQ_MAX_TOKENS=4000

# AI Worker and execution controls
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
AI_CONCURRENCY=2
AI_POLL_INTERVAL_MS=2000
AI_LEASE_MS=60000
AI_RETENTION_DAYS=30
AI_EVAL_CACHE_ENABLED=true

# Logging level (info, debug, warn, error, silent)
LOG_LEVEL=info
